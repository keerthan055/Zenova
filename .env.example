# ==============================================================================
# ZENOVA Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env

# Environment Tier: development | testing | staging | production
ZENOVA_ENV=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Logging & Monitoring
ZENOVA_LOG_LEVEL=INFO
ZENOVA_STRUCTURED_LOGGING=false
SENTRY_DSN=

# Database URLs (Default local SQLite)
DATABASE_URL=sqlite+aiosqlite:///data/zenova.db
DATABASE_URL_SYNC=sqlite:///data/zenova.db

# Security & Secrets (Development default - never use in production)
ZENOVA_SECRET_KEY=zenova-dev-secret-key-do-not-use-in-production
ZENOVA_CORS_ORIGINS=["*"]
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Authentication & Session Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Email Provider Configuration (development | smtp)
EMAIL_PROVIDER=development
FRONTEND_BASE_URL=http://localhost:8000
EMAIL_FROM=noreply@zenova.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=15

# Cache & Message Broker (Optional for local dev, uses in-memory)
REDIS_URL=redis://localhost:6379/0

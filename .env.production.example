# ==============================================================================
# ZENOVA Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual production credentials to version control!
# Populate these values in your cloud secret manager (AWS Secrets Manager,
# GCP Secret Manager, Azure Key Vault, or Kubernetes Secrets).

# Environment Tier: strictly 'production'
ZENOVA_ENV=production

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=4

# Production Structured Logging & Error Reporting
ZENOVA_LOG_LEVEL=INFO
ZENOVA_STRUCTURED_LOGGING=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Production PostgreSQL Database Connection Strings
# Replace user, password, host, port, and dbname with your cloud RDS/CloudSQL endpoint
DATABASE_URL=postgresql+asyncpg://zenova_app:SECURE_PASSWORD@postgres.internal.zenova.ai:5432/zenova_prod
DATABASE_URL_SYNC=postgresql://zenova_app:SECURE_PASSWORD@postgres.internal.zenova.ai:5432/zenova_prod

# Production Security & JWT Secret (Generate with: openssl rand -hex 32)
ZENOVA_SECRET_KEY=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOM_HEX_STRING_FOR_PRODUCTION
ZENOVA_CORS_ORIGINS=["https://app.zenova.ai","https://clinician.zenova.ai"]

# Rate Limiting & DoS Protection
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Redis Connection (Session buffer, rate limiting, and cache)
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis.internal.zenova.ai:6379/0

# Optional LLM Cloud Provider Keys (If using remote managed LLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
